@startuml SD_SubmitPrivateEVChargingRequest
skinparam style strictuml
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam maxMessageSize 180
skinparam sequenceMessageAlign center
skinparam sequence {
  ArrowColor #42566B
  LifeLineBorderColor #8295A8
  LifeLineBackgroundColor #D8EAFE
  ParticipantBorderColor #42566B
  ParticipantBackgroundColor #E8F1FA
  GroupBorderColor #8295A8
  GroupBackgroundColor #F4F7FA
}
hide footbox
title UC-P02 — Submit a Private-EV Charging Request

actor Student as ST
boundary "Student Portal" as UI
control "Charging Request Service" as SVC
entity "Mobility Records" as DATA

ST -> UI : Open charging form for parking booking
UI -> SVC : loadChargingContext(parkingRef)
SVC -> DATA : Read owned parking and Hub status
DATA --> SVC : Current context
SVC --> UI : Vehicle, Hub and permitted window
UI --> ST : Show form

ST -> UI : Submit battery target and charging window
UI -> SVC : submitRequest(draft, operationRef)
SVC -> DATA : Recheck owner and parking eligibility
DATA --> SVC : Current state
alt Parking ineligible or data unavailable
  SVC --> UI : Reason; no change
  UI --> ST : Show error
else Eligible parking
  SVC -> SVC : Validate inputs and estimate duration
  alt Invalid input
    SVC --> UI : Reason; no request saved
    UI --> ST : Revise input
  else Valid request
    SVC -> DATA : Read point availability and FCFS queue
    DATA --> SVC : Current Hub capacity and order
    alt Requested start in the future
      SVC -> DATA : Save Waiting request without allocation
      DATA --> SVC : Request reference and queue position
      SVC --> UI : Waiting until requested start
      UI --> ST : Show queue position; no point promised
    else Hub capacity full for eligible request
      SVC -> DATA : Save Waiting request without allocation
      DATA --> SVC : Request reference and queue position
      SVC --> UI : Full, Waiting and position
      UI --> ST : Show waitlist position
    else Eligible request and point currently free
      SVC -> DATA : Save Scheduled request and allocation atomically
      DATA --> SVC : Request reference, point and interval
      SVC --> UI : Scheduled assignment
      UI --> ST : Show charging schedule
    end
  end
end

note over SVC,DATA
  Use one Hub FCFS queue. Exact timestamp ties use lower battery.
  A failed write preserves the previous state; retry by operationRef.
end note
@enduml
