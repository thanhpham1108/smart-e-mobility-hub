@startuml SD_GenerateChargingSchedule
skinparam style strictuml
skinparam sequenceMessageAlign center
skinparam linetype ortho
skinparam boxPadding 10
skinparam maxMessageSize 200
skinparam sequenceLifeLineBorderColor #0284C7
skinparam sequenceLifeLineBackgroundColor #BAE6FD

title Sequence Diagram: Generate Charging Schedule (UC-C02) - Automatic FCFS

actor "Student / Parking Service" as Caller
participant "Charging Request UI" as UI #E0F2FE
participant "Charging Controller" as Ctrl #F0FDF4
participant "Charging Request" as Req #FEF3C7
participant "Charging Point" as Point #FEF3C7
participant "Charging Schedule" as Sched #FEF3C7

Caller -> UI : Submit charging draft
activate UI
UI -> Ctrl : submitRequest(draft)
activate Ctrl
Ctrl -> Req : validateDraftAndTimestamp(draft)
activate Req
Req -->> Ctrl : valid draft / validation error
deactivate Req
alt Invalid draft
  Ctrl -->> UI : Show validation error
else Valid draft
  Ctrl -> Sched : loadCurrentAllocations(hubId)
  activate Sched
  Sched -->> Ctrl : committed allocations / read failure
  deactivate Sched
  Ctrl -> Point : getOperationalPointsAndOptionalPower(hubId)
  activate Point
  Point -->> Ctrl : points and optional power / point read failure
  deactivate Point
  alt Required data unavailable
    Ctrl -->> UI : Show data error; keep previous schedule
  else Data available
    Ctrl -> Ctrl : estimateDurationForDisplayIfPossible(draft, pointPower)
    Ctrl -> Ctrl : checkStartEligibilityAndCurrentPointFCFS(draft, allocations, points)
    note right of Ctrl
      FCFS by submission time; lower battery
      breaks exact timestamp ties only.
    end note
    alt Requested start is in the future
      Ctrl -> Sched : saveWaitingRequest(draft, submittedAt)
      activate Sched
      Sched -->> Ctrl : Waiting request and queue position / save failure
      deactivate Sched
      alt Save failed
        Ctrl -->> UI : Show error; old schedule unchanged
      else Saved
        Ctrl -->> UI : Waiting until requested start; no point promised
        UI -->> Caller : Show queue position
      end
    else Hub capacity full for eligible request
      Ctrl -> Sched : saveWaitingRequest(draft, submittedAt)
      activate Sched
      Sched -->> Ctrl : Waiting request and queue position / save failure
      deactivate Sched
      alt Save failed
        Ctrl -->> UI : Show error; old schedule unchanged
      else Saved
        Ctrl -->> UI : Full, Waiting and queue position
        UI -->> Caller : Show waitlist position; no allocation
      end
    else Eligible request and point currently free
      Ctrl -> Sched : saveRequestAndAllocationAtomically(draft, point, interval)
      activate Sched
      Sched -->> Ctrl : Scheduled request / save failure
      deactivate Sched
      alt Save failed
        Ctrl -->> UI : Show error; old schedule unchanged
      else Save succeeded
        Ctrl -->> UI : Show assigned point and interval
        UI -->> Caller : Request is Scheduled
      end
    end
  end
end

deactivate Ctrl
deactivate UI
@enduml
