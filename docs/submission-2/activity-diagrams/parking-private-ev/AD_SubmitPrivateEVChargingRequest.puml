@startuml AD_SubmitPrivateEVChargingRequest
skinparam style strictuml
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam conditionStyle insideDiamond
skinparam activityShape rounded
skinparam roundCorner 14
skinparam ActivityBorderColor #42566B
skinparam ActivityBackgroundColor #F0F6FB
skinparam ActivityDiamondBorderColor #A67C23
skinparam ActivityDiamondBackgroundColor #FFF4D6
skinparam ArrowColor #42566B
skinparam activity<<status>> {
  RoundCorner 4
  BackgroundColor #F8FAFC
  BorderColor #64748B
}
title UC-P02 — Submit a Private-EV Charging Request

|#E0F2FE|Student|
start
:Open charging form for parking booking;
|#F0FDF4|System|
:Load owned parking and Hub context;
if (Parking eligible?) then (no)
  :Show parking or data error; <<status>>
  stop
endif
|#E0F2FE|Student|
:Submit battery target and charging window;
|#F0FDF4|System|
:Validate inputs and estimate duration;
if (Charging time sufficient?) then (no)
  :Show input or time error; <<status>>
  stop
endif
|#FEF3C7|Database|
:Recheck parking and read Hub capacity;
|#F0FDF4|System|
if (Hub capacity available?) then (yes)
  |#FEF3C7|Database|
  :Save Scheduled request and allocation together;
  |#E0F2FE|Student|
  :See assigned point and interval; <<status>>
  stop
else (no)
  |#FEF3C7|Database|
  :Save Waiting request without allocation;
  |#E0F2FE|Student|
  :See Full and Hub waitlist position; <<status>>
  stop
endif
@enduml
