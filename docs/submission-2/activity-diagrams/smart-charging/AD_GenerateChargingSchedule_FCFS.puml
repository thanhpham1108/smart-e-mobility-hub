@startuml AD_GenerateChargingSchedule_FCFS
skinparam style strictuml
skinparam linetype ortho
skinparam conditionStyle insideDiamond
skinparam activityShape rounded
skinparam roundCorner 14
skinparam defaultFontName sans-serif
skinparam ActivityBorderColor #0369A1
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityDiamondBorderColor #B45309
skinparam ActivityDiamondBackgroundColor #FEF3C7
skinparam ArrowColor #1E293B
skinparam activity<<status>> {
  RoundCorner 4
  BackgroundColor #F8FAFC
  BorderColor #64748B
}

title Activity Diagram: Automatic FCFS Charging Allocation

|#E0F2FE|Student / Parking|
start
:Submit charging draft;

|#F0FDF4|ChargingController|
:Validate parking, battery values
and requested window;
if (Valid draft?) then (no)
  :Show validation error; <<status>>
  stop
endif
:Record submission instant;
:Estimate duration for display
when inputs are available;

|#FEF3C7|Database|
:Read point status, optional power
and existing allocations;

|#F0FDF4|ChargingController|
if (Required data available?) then (no)
  :Show data error; keep old schedule; <<status>>
  stop
endif
:Check requested start and current
point occupancy in FCFS order;
if (Requested start reached?) then (no)
  |#FEF3C7|Database|
  :Save Waiting request without allocation;
  |#F0FDF4|ChargingController|
  if (Save succeeded?) then (no)
    :Show save error; keep old schedule; <<status>>
    stop
  endif
  |#E0F2FE|Student / Parking|
  :Show Waiting until requested start; <<status>>
  stop
endif
if (Charging point currently free?) then (yes)
  |#FEF3C7|Database|
  :Save Scheduled request and allocation together;
  |#F0FDF4|ChargingController|
  if (Save succeeded?) then (no)
    :Show save error; keep old schedule; <<status>>
    stop
  endif
  |#E0F2FE|Student / Parking|
  :Show assigned point and interval; <<status>>
  stop
else (no)
  |#FEF3C7|Database|
  :Save Waiting request without allocation;
  |#F0FDF4|ChargingController|
  if (Save succeeded?) then (no)
    :Show save error; keep old schedule; <<status>>
    stop
  endif
  |#E0F2FE|Student / Parking|
  :Show Full and Hub waitlist position; <<status>>
  stop
endif
@enduml
