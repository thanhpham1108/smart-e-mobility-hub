@startuml
left to right direction
skinparam style strictuml
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName sans-serif
skinparam roundCorner 8
skinparam ArrowFontSize 11
skinparam state {
  BorderColor #334155
  FontSize 13
  BackgroundColor #F8FAFC
}
title ChargingRequest lifecycle
state Waiting #FEF3C7
state Scheduled #E0E7FF
state Charging #D1FAE5
state Completed #DCFCE7
state Suspended #FFE4E6
state Cancelled #F1F5F9
state Expired #F1F5F9
[*] --> Waiting : valid request; Hub full
[*] --> Scheduled : point available
Waiting --> Scheduled : capacity opens [FCFS head]
Waiting --> Cancelled : cancel
Waiting --> Expired : requested window ends
Scheduled --> Charging : start signal
Scheduled --> Cancelled : cancel, 15-minute timeout
Charging --> Completed : target reached, Student completes early
Charging --> Cancelled : cancel
Charging --> Suspended : fault
Suspended --> Charging : resume
Suspended --> Cancelled : stop
Completed --> [*]
Cancelled --> [*]
Expired --> [*]
@enduml
