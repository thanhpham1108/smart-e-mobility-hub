@startuml Deployment_View
title Smart E-Mobility Hub — Deployment View (Submission 3)
top to bottom direction
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 55
skinparam ranksep 65
skinparam defaultTextAlignment center
skinparam backgroundColor #FFFFFF

node "Student device" <<device>> as Student #DDF3FF {
  node "Browser" <<executionEnvironment>> as StudentBrowser #F2FAFF {
    artifact "Student Portal\nUI and temporary selection" as StudentUI #DDF5B8
  }
}

node "Operator device" <<device>> as Operator #DDF3FF {
  node "Browser" <<executionEnvironment>> as OperatorBrowser #F2FAFF {
    artifact "Operator Portal\nUI and temporary selection" as OperatorUI #DDF5B8
  }
}

node "Telemetry simulator host" <<device>> as Simulator #DDF3FF {
  artifact "Mock telemetry producer\nvehicle / parking / charging events" as Producer #DDF5B8
}

node "Application host" <<device>> as Application #FFF0C2 {
  node "Web/API process" <<executionEnvironment>> as Runtime #FFF9E8 {
    artifact "HTTPS API handlers\nsession, role and source checks" as API #DDF5B8
    artifact "Hub & Identity\nauthentication · Hub status" as Hub #DDF5B8
    artifact "Vehicle Rental\nreservation · trips" as Rental #DDF5B8
    artifact "Parking & Private EV\nbooking · occupancy" as Parking #DDF5B8
    artifact "Fleet & Incident\ntelemetry · faults" as Fleet #DDF5B8
    artifact "Smart Charging\nFCFS · waitlist · allocation" as Charging #DDF5B8
    artifact "What-if Simulation\nisolated network copy" as Simulation #DDF5B8
    artifact "Internal scheduler\nstart eligibility · expiry · timeout · health" as Scheduler #DDF5B8
    artifact "Authoritative in-memory state\nUnit of Work · request/event ledger" as State #DDF5B8
    artifact "Audit/event log\nstate transitions and failures" as Audit #DDF5B8
  }
  artifact "JSON seed fixtures" as Fixtures #DDF5B8
}

Student -- Application
Operator -- Application
Simulator -- Application : HTTPS / authenticated telemetry

Student -[hidden]right- Operator
Operator -[hidden]right- Simulator
API -[hidden]down- Hub
Hub -[hidden]right- Rental
Rental -[hidden]right- Parking
Hub -[hidden]down- Fleet
Fleet -[hidden]right- Charging
Charging -[hidden]right- Simulation
Fleet -[hidden]down- Scheduler
Scheduler -[hidden]right- State
State -[hidden]right- Audit

@enduml
