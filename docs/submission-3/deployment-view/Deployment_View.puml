@startuml Deployment_View
title Smart E-Mobility Hub — Deployment View (Submission 3)
left to right direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultTextAlignment center

node "Student device" <<device>> as StudentDevice {
  node "Browser" <<executionEnvironment>> as StudentBrowser {
    artifact "Student Portal\n(UI + in-progress selection)" as StudentUI
  }
}

node "Operator device" <<device>> as OperatorDevice {
  node "Browser" <<executionEnvironment>> as OperatorBrowser {
    artifact "Operator Portal\n(UI + in-progress selection)" as OperatorUI
  }
}

node "Application host" <<device>> as ApplicationHost {
  node "Web/API process" <<executionEnvironment>> as ApplicationProcess {
    artifact "API handlers and role checks" as API
    artifact "Six domain modules" as Domain
    artifact "In-memory operational state" as State
  }
  artifact "JSON seed fixtures" as Fixtures
}

node "Telemetry simulator" <<device>> as SimulatorHost {
  artifact "Timestamped mock event producer" as Producer
}

StudentBrowser --> ApplicationProcess : HTTPS — Student operations
OperatorBrowser --> ApplicationProcess : HTTPS — Operator operations
SimulatorHost --> ApplicationProcess : authenticated mock telemetry events
Fixtures --> State : load seed data

note bottom of ApplicationHost
  The brief does not require a production database.
  Authoritative bookings, schedules and sessions
  are decided inside the application process.
end note
@enduml
